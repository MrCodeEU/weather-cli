diff --git a/ansible/inventory/group_vars/all/all.yml b/ansible/inventory/group_vars/all/all.yml
index 0000000..0000000 100644
--- a/ansible/inventory/group_vars/all/all.yml
+++ b/ansible/inventory/group_vars/all/all.yml
@@ -282,6 +282,14 @@ services:
     icon: "mdi:email-newsletter"
     backup_critical: true
 
+  - name: weather-cli
+    enabled: true
